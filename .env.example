# Copy to .env for docker compose / local api runs. Never commit .env.

# --- postgres (compose) ---
POSTGRES_PASSWORD=change-me

# --- api ---
# For bare-metal `go run`: host localhost; compose overrides with service name.
DATABASE_URL=postgres://kicca:change-me@localhost:5432/kicca?sslmode=disable
JWT_SECRET=change-me-long-random-string
# First-boot seed admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# 32 bytes base64, AES-256-GCM key for GitHub PATs at rest: openssl rand -base64 32
GH_ENC_KEY=
GITHUB_API_BASE=https://api.github.com

# --- web (bare-metal dev only) ---
# Vite dev proxy target. Default is the Docker service name http://api:8080;
# set this when running the api outside compose.
VITE_API_PROXY_TARGET=http://localhost:8080
